 0009				COL_LOOP:
 0009  8A D3			    MOV DL,BL
 000B  B4 02			    MOV AH,02H
 000D  CD 21			    INT 21H
 000F  FE C3			    INC BL
 0011  83 F9 01			    CMP CX,1             ; Last column has no t
				railing space.
 0014  74 06			    JE NO_SPACE
 0016  B2 20			    MOV DL,' '
 0018  B4 02			    MOV AH,02H
 001A  CD 21			    INT 21H
 001C				NO_SPACE:
 001C  E2 EB			    LOOP COL_LOOP        ; CX = CX - 1; jump wh
				en CX != 0.
 001E  B2 0D			    MOV DL,0DH           ; DOS line ending: CR 
				followed by LF.
 0020  B4 02			    MOV AH,02H
 0022  CD 21			    INT 21H
 0024  B2 0A			    MOV DL,0AH
 0026  B4 02			    MOV AH,02H
 0028  CD 21			    INT 21H
 002A  59			    POP CX               ; Restore outer count 
				before outer LOOP.
 002B  E2 D8			    LOOP ROW_LOOP
 002D  B8 4C00			    MOV AX,4C00H
 0030  CD 21			    INT 21H
				END START
